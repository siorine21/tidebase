# ================================
# TIDEBASE 環境変数テンプレート
# このファイルをコピーして .env を作成し、実際の値を入力してください
# .env は .gitignore に含まれており、コミットされません
# ================================

# Supabase（Phase 0 手順書 Step 4 で取得した値を設定）
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here
# JWT 検証は JWKS（ES256/RS256）が第一。以下はレガシー HS256 プロジェクトのみ必要
SUPABASE_JWT_SECRET=your_jwt_secret_here
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres

# AWS
AWS_PROFILE=yuki
AWS_REGION=ap-northeast-1
S3_MEDIA_BUCKET=tidebase-media-dev

# 外部 API（Phase 2 で取得）
OPENWEATHER_API_KEY=your_key_here

# アプリ設定
ENVIRONMENT=development
STAGE=dev
SECRET_KEY=your_secret_key_here
