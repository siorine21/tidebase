# ================================
# TIDEBASE 環境変数テンプレート（GitHub + Supabase 構成・D-021）
# 実際の値は Claude Code 環境のシークレット / GitHub リポジトリ Secrets に設定する。
# .env をローカルで使う場合もコミットしない（.gitignore 済み）
# ================================

# Supabase 運用（scripts/supabase_admin.py 用）
SUPABASE_ACCESS_TOKEN=your_personal_access_token_here
SUPABASE_PROJECT_REF=your_project_ref_here

# Supabase 接続（keepalive / フロント開発用。anon キーは公開前提の値）
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# 外部 API: 天気は Open-Meteo・潮汐は気象庁（いずれも API キー不要）
